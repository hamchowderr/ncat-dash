# Written by `npx convex dev` for your own deployment.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Where this dashboard is served.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog browser analytics (the project token is a public client-side key).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# These live on the Convex deployment, not in this file. Set each with `npx convex env set`:
#   SITE_URL             the dashboard address, same as NEXT_PUBLIC_SITE_URL
#   BETTER_AUTH_SECRET   openssl rand -base64 32
#   CONNECTIONS_SECRET   openssl rand -base64 32 (encrypts saved toolkit keys; losing it means reconnecting)
#   NCAT_EDITION         self-hosted (default) or hosted
#   HOSTED_TOOLKIT_URL   optional: a toolkit you run for teams; teams on it get no Toolkit page
#   HOSTED_TOOLKIT_API_KEY  optional, with the URL: setting up offers "No, Not Yet: Just use ours for now"
#   MASTRA_JWT_SECRET    the same value as below, for @Agent in review rooms
#   AGENT_URL            the agent server's address, for @Agent in review rooms
#   TRUSTED_ORIGINS      optional: more addresses allowed to sign in, comma-separated, * allowed
# Integrations (Discord, Telegram, Teams, Zoom, Google Meet, Microsoft 365, Dropbox, B-Roll
# stock) each add a few more. The full list is in docs/self-hosting.md, Every Setting.
#
# Email (optional). Usually set in the dashboard under Settings, Email. Setting these
# instead fixes it for the whole deployment and wins over Settings:
#   TOSEND_API_KEY              a sending key from https://tosend.com (starts with tsend_)
#   EMAIL_FROM                  the address to send from, on a domain verified in toSend
#   EMAIL_FROM_NAME             the sender name people see (optional)
#   REQUIRE_EMAIL_VERIFICATION  true makes new accounts confirm their address before signing in


# The agent (see The agent in the README). Without these the Agent chat stays signed out.
MASTRA_SERVER_URL=http://127.0.0.1:4111
MASTRA_JWT_SECRET=
