# Written by `npx convex dev` for your own deployment.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Where this dashboard is served.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# These live on the Convex deployment, not in this file. Set each with `npx convex env set`:
#   SITE_URL             the dashboard address, same as NEXT_PUBLIC_SITE_URL
#   BETTER_AUTH_SECRET   openssl rand -base64 32
#   CONNECTIONS_SECRET   openssl rand -base64 32 (encrypts saved toolkit keys; losing it means reconnecting)
#   NCAT_EDITION         self-hosted (default) or hosted
#
# Email (optional). Usually set in the dashboard under Settings, Email. Setting these
# instead fixes it for the whole deployment and wins over Settings:
#   TOSEND_API_KEY              a sending key from https://tosend.com (starts with tsend_)
#   EMAIL_FROM                  the address to send from, on a domain verified in toSend
#   EMAIL_FROM_NAME             the sender name people see (optional)
#   REQUIRE_EMAIL_VERIFICATION  true makes new accounts confirm their address before signing in
