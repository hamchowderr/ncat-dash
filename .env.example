# Written by `npx convex dev` for your own deployment.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Where this dashboard is served.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# These live on the Convex deployment, not in this file. Set each with `npx convex env set`:
#   SITE_URL             the dashboard address, same as NEXT_PUBLIC_SITE_URL
#   BETTER_AUTH_SECRET   openssl rand -base64 32
#   CONNECTIONS_SECRET   openssl rand -base64 32 (encrypts saved toolkit keys; losing it means reconnecting)
#   NCAT_EDITION         self-hosted (default) or hosted

# The agent (see The agent in the README). Without these the Agent chat stays signed out.
MASTRA_SERVER_URL=http://127.0.0.1:4111
MASTRA_JWT_SECRET=
