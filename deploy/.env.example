# Copy to deploy/.env and fill in. Read by deploy/compose.yml.
# Make each secret with: openssl rand -hex 32

# ── Public addresses (https, no trailing slash) ─────────────────────────────
# Each points, through your reverse proxy, at the port named in compose.yml.
CONVEX_URL=https://api.example.com          # -> 127.0.0.1:3210
CONVEX_SITE_URL=https://site.example.com    # -> 127.0.0.1:3211
# The dashboard, the toolkit and the agent server get addresses too; they are not read
# here but you type them in later (the dashboard and agent in Convex, the toolkit in
# the dashboard).
#   https://app.example.com       -> 127.0.0.1:3000
#   https://toolkit.example.com   -> 127.0.0.1:8080
#   https://agent.example.com     -> 127.0.0.1:4111

# ── Convex backend ───────────────────────────────────────────────────────────
CONVEX_INSTANCE_NAME=kontentifi
CONVEX_INSTANCE_SECRET=

# ── Toolkit ──────────────────────────────────────────────────────────────────
# The key the dashboard uses to call the toolkit. Paste the same value in the
# dashboard when it asks for your toolkit.
TOOLKIT_API_KEY=
# The bucket the toolkit keeps files in (Cloudflare R2, AWS S3, DigitalOcean Spaces,
# MinIO, Backblaze B2). For R2: https://<account id>.r2.cloudflarestorage.com, region auto.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
# Optional: a public address for the bucket, such as an R2 custom domain.
S3_PUBLIC_URL=
# How much of the machine the toolkit may use.
TOOLKIT_CPUS=4
TOOLKIT_MEMORY=8g
# Jobs the toolkit runs at once. Left empty: half the CPUs it may use.
QUEUE_WORKERS=

# ── Agent server ─────────────────────────────────────────────────────────────
AGENT_APP_SECRET=
# Shared with the web app and with Convex. One value everywhere.
# (The web app reaches the agent at http://agent:4111 inside Docker; set
# MASTRA_SERVER_URL only if the agent runs somewhere else.)
MASTRA_JWT_SECRET=
CHAT_MODEL=anthropic/claude-sonnet-5-5
# A key for the model's provider (only the one CHAT_MODEL uses).
ANTHROPIC_API_KEY=

# ── Pinning (recommended on a server you rely on) ────────────────────────────
# TOOLKIT_IMAGE=ghcr.io/hamchowderr/no-code-architects-toolkit:sha-<commit>
# AGENT_IMAGE=ghcr.io/hamchowderr/ncat-dash-agent:sha-<commit>
# WEB_IMAGE=ghcr.io/hamchowderr/ncat-dash-web:sha-<commit>
# CONVEX_IMAGE=ghcr.io/convex/convex-backend:<version>
# CONVEX_DASHBOARD_IMAGE=ghcr.io/convex/convex-dashboard:<version>

# ── Convex tuning ────────────────────────────────────────────────────────────
# Seconds a function may take before Convex stops it (Convex's own default is 1).
# CONVEX_FUNCTION_TIMEOUT_SECONDS=5
