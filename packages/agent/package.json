{
  "name": "@takewon/agent",
  "version": "0.1.0",
  "description": "Agent server for the dashboard: Mastra AgentController with the mastra-chat-kit route contract",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:mock": "aimock --config aimock.json",
    "dev:record": "aimock --config aimock.record.json",
    "dev:replay": "aimock --config aimock.replay.json",
    "setup:browser": "playwright-core install chromium",
    "eval": "tsx scripts/eval.ts",
    "measure:cache": "tsx scripts/measure-cache.ts",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "measure:session": "tsx scripts/measure-session.ts"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.19",
    "@ai-sdk/openai": "^4.0.20",
    "@anthropic-ai/sdk": "^1.11.0",
    "@chat-adapter/discord": "4.45.0",
    "@chat-adapter/slack": "4.45.0",
    "@chat-adapter/teams": "4.45.0",
    "@chat-adapter/telegram": "4.45.0",
    "@mastra/agent-browser": "0.6.0",
    "@mastra/ai-sdk": "1.12.0",
    "@mastra/auth": "1.2.0",
    "@mastra/browser-firecrawl": "0.3.0",
    "@mastra/browser-viewer": "0.3.0",
    "@mastra/core": "1.83.0",
    "@mastra/duckdb": "1.19.0",
    "@mastra/editor": "0.17.1",
    "@mastra/evals": "1.10.11",
    "@mastra/fastembed": "1.3.7",
    "@mastra/libsql": "1.30.0",
    "@mastra/loggers": "1.3.10",
    "@mastra/mcp": "2.9.0",
    "@mastra/memory": "1.41.1",
    "@mastra/observability": "1.24.0",
    "@mastra/posthog": "^1.4.10",
    "@mastra/server": "1.83.0",
    "agent-browser": "0.19.0",
    "ai": "^7.0.37",
    "chat": "4.45.0",
    "convex": "^1.50.0",
    "hono": "^4.13.8",
    "mysql2": "^3.22.3",
    "posthog-node": "^6.1.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.37.4",
    "@types/node": "^25.6.0",
    "@vitest/ui": "^4.1.12",
    "mastra": "1.39.0",
    "playwright-core": "1.61.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "private": true
}
