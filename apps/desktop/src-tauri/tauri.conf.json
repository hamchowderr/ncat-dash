{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kontentifi",
  "version": "0.1.0",
  "identifier": "io.otakusolutions.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your content, social media ready.",
    "longDescription": "Kontentifi in its own window. Sign in to your Kontentifi, hosted or on your own server.",
    "copyright": "Otaku Solutions. Licensed AGPL-3.0-or-later.",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
