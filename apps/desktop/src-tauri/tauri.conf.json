{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Takewon",
  "version": "0.1.0",
  "identifier": "io.otakusolutions.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your content, social media ready.",
    "longDescription": "Takewon in its own window. Sign in to your Takewon, hosted or on your own server.",
    "copyright": "Otaku Solutions. Licensed AGPL-3.0-or-later.",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCQUY5RTE4NjhFM0NENUYKUldSZnplTm9HSjZ2eTEvOVUzaTg5OHh6Y1o5clFReStRNjhMMk5oZkUrckEwTytha2x2RzdaN2UK",
      "endpoints": [
        "https://github.com/hamchowderr/ncat-dash/releases/latest/download/latest.json"
      ]
    }
  }
}
